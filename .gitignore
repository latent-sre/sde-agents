# Python bytecode caches (created by running scripts/*.py and tests)
__pycache__/
*.pyc

# Transient routing-eval console logs; distilled results live in the baseline summary
# and the machine-readable benchmark.json anchors.
evals/baselines/**/*.log

# Probe leftovers. scripts/probe_plugin.py removes its workspace only when the run PASSES —
# a failing probe deliberately keeps both of these for debugging, which is exactly when a
# maintainer is least likely to notice them in `git status`.
.probe-tmp/
probe-transcript.jsonl

# Acceptance-evidence run logs (probe and pilot-workflow sessions). Raw session streams can
# carry repository content and belong beside the round's other transient evidence, never in
# the tree; the distilled numbers live in the archived evidence note.
.probe-run.log
.pilot-run.jsonl
.pilot-run.err

# Learning-ledger writer state is transactional, not evidence. Candidate JSON is tracked; the
# lock and same-directory atomic-write temporaries must never enter a review with `git add -A`.
learning/candidates/.learning-ledger.lock
learning/candidates/.lc_*.tmp
